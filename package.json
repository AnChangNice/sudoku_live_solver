{
  "name": "sudoku-live-solver",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "实时摄像头数独求解器：纯前端，识别纸质数独并把答案叠加回视频",
  "scripts": {
    "predev": "node scripts/copy-opencv.mjs",
    "dev": "vite",
    "dev:lan": "vite --mode lan",
    "prebuild": "node scripts/copy-opencv.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"test/**/*.test.js\"",
    "test:e2e": "playwright test",
    "train:digits": "node scripts/train-digits.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/roboto": "^5.3.0"
  },
  "devDependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@techstark/opencv-js": "4.12.0-release.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "vite": "^8.3.5"
  }
}
